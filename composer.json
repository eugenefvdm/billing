{
    "name": "eugenefvdm/billing",
    "description": "A Laravel service provider and Livewire UI components for Payfast and EFT subscription billing",
    "keywords": [
        "php",
        "laravel",
        "livewire",
        "subscription-billing",
        "subscriptions",
        "recurring-billing",
        "payfast",
        "payment-gateway",
        "eft",
        "south-africa",
        "invoice",
        "credit card",
        "pdf-invoices"
    ],
    "authors": [
        {
            "name": "Eugene van der Merwe",
            "email": "eugene@vander.host",
            "role": "Developer"
        }
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Eugenefvdm\\Billing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Eugenefvdm\\Billing\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.3",
        "symfony/dotenv": "*",
        "livewire/livewire": "*",
        "moneyphp/money": "*",
        "spatie/ray": "*",
        "nunomaduro/collision": "*",
        "guzzlehttp/guzzle": "*",
        "guzzlehttp/psr7": "*"
    },
    "require-dev": {
        "orchestra/testbench": "9",
        "spatie/laravel-ray": "*",
        "pestphp/pest": "^2.36",
        "pestphp/pest-plugin-drift": "^2.5"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Eugenefvdm\\Billing\\BillingServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    }
}